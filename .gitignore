# Terraform working directory
**/.terraform/*

# Terraform state
*.tfstate
*.tfstate.*

# Terraform variable files
*.tfvars
*.tfvars.json

# Terraform crash logs
crash.log
crash.*.log

# Saved plan files
*.tfplan

# Terraform state lock
.terraform.tfstate.lock.info

# Go build output
/app/network-fault-observation

# Private keys
*.pem
*.key

# Packet captures may contain client/network addresses
*.pcap

# Generated demo assets
demo/assets/